# Copy this file to `.env` and fill in a key ONLY if you want to use --real
# (a live LLM call). Offline mode -- the default -- needs none of this.
#
# `.env` is git-ignored; never commit a real key.

# Free option (recommended to start): Google Gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model the --real path calls. Any LiteLLM model string works.
# Examples: gemini/gemini-1.5-flash  |  groq/llama-3.1-8b-instant  |  gpt-4o-mini
EXTRACTOR_MODEL=gemini/gemini-1.5-flash

# Where the API stores resumes (optional; defaults to resumes.db).
# EXTRACTOR_DB=resumes.db
